# ==============================================================================
# SYNCORA - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# This template contains all required and optional environment variables for 
# deploying Syncora to Vercel or running locally.
# 
# For detailed setup instructions, refer to VERCEL_DEPLOYMENT.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Supabase / Neon / Railway PostgreSQL connection string
# Format: postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. NEXTAUTH CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Generate a random 32-byte secret (e.g., via `openssl rand -base64 32`)
NEXTAUTH_SECRET=

# Canonical production URL (e.g., https://syncora.vercel.app or http://localhost:3000)
# Note: Do not include a trailing slash.
NEXTAUTH_URL=

# ------------------------------------------------------------------------------
# 3. SUPABASE CLIENT KEYS (Required for Realtime CDC & Client SDK)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 4. GITHUB OAUTH (Optional - If using GitHub Login)
# ------------------------------------------------------------------------------
# Found in GitHub Developer Settings -> OAuth Apps
# Callback URL: https://your-vercel-url.vercel.app/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# ------------------------------------------------------------------------------
# 5. AZURE / MICROSOFT ENTRA ID (Optional - Enterprise SSO Integration)
# ------------------------------------------------------------------------------
# Found in Azure Portal -> App Registrations
# Callback URL: https://your-vercel-url.vercel.app/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# ------------------------------------------------------------------------------
# 6. UPSTASH REDIS (Optional - Rate Limiting & Distributed Caching)
# ------------------------------------------------------------------------------
# Found in Upstash Console -> Redis -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 7. MICROSOFT TEAMS INTEGRATION (Optional - Workflow Webhooks)
# ------------------------------------------------------------------------------
# Generated via Teams Channel -> Connectors -> Incoming Webhook
TEAMS_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 8. RESEND EMAIL SERVICE (Optional - Transactional Email Automation)
# ------------------------------------------------------------------------------
# Found in Resend Dashboard -> API Keys
RESEND_API_KEY=
