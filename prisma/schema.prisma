generator client {
  provider        = "prisma-client-js"
  output          = "./generated/client"
  previewFeatures = ["postgresqlExtensions", "tracing"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
  SUPER_ADMIN // System-level admin across tenants
}

enum GoalSheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
}

enum GoalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
}

enum ProgressStatus {
  NOT_STARTED
  AT_RISK
  ON_TRACK
  COMPLETED
}

enum UOMType {
  NUMERIC_MIN
  NUMERIC_MAX
  PERCENTAGE
  TIMELINE
  ZERO_BASED
}

enum MetricDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
  ZERO_BASED
  TIMELINE
}

enum Quarter {
  Q1
  Q2
  Q3
  Q4
}

enum AuditAction {
  CREATE_GOAL
  UPDATE_GOAL
  DELETE_GOAL
  SUBMIT_GOALS
  APPROVE_GOALS
  REJECT_GOALS
  RETURN_GOALS
  UNLOCK_GOALS
  UPDATE_CHECKIN
  UPDATE_WEIGHTAGE
  CREATE_SHARED_GOAL
  ASSIGN_SHARED_GOAL
  CREATE_CYCLE
  UPDATE_CYCLE
}

enum NotificationType {
  INFO
  APPROVAL
  REJECTION
  REWORK
  CHECKIN
  UNLOCK
}

enum EscalationType {
  SUBMISSION_OVERDUE
  APPROVAL_OVERDUE
  CHECKIN_OVERDUE
  REVIEW_OVERDUE
}

enum EscalationStatus {
  ACTIVE
  RESOLVED
  IGNORED
}

enum EscalationLevel {
  MANAGER
  HR
  EXECUTIVE
}

// ------------------------------------------------------
// Multi-Tenancy Core
// ------------------------------------------------------
model Organization {
  id        String   @id @default(cuid())
  name      String
  domain    String?  @unique
  plan      String   @default("ENTERPRISE")
  
  users          User[]
  goalSheets     GoalSheet[]
  goals          Goal[]
  sharedGoals    SharedGoal[]
  cycles         Cycle[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  checkIns       CheckIn[]
  escalations    Escalation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([createdAt])
  @@index([plan])
}

// ------------------------------------------------------
// Application Models
// ------------------------------------------------------

model User {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  email      String       @unique
  password   String?      // Optional for SSO users
  role       Role

  managerId  String?
  manager    User?        @relation("ManagerEmployees", fields: [managerId], references: [id], onDelete: SetNull)
  employees  User[]       @relation("ManagerEmployees")

  goalSheets          GoalSheet[]       @relation("EmployeeGoalSheets")
  ownedSharedGoals    SharedGoal[]      @relation("SharedGoalOwner")
  goalAssignments     GoalAssignment[]
  checkInComments     CheckInComment[]  @relation("ManagerCheckInComments")
  auditLogs           AuditLog[]        @relation("ActorAuditLogs")
  notifications       Notification[]
  employeeEscalations Escalation[]      @relation("EmployeeEscalations")
  managerEscalations  Escalation[]      @relation("ManagerEscalations")
  accounts            Account[]
  sessions            Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([managerId])
  @@index([tenantId, role])
  @@index([tenantId, createdAt])
  @@index([email, tenantId])
}

model GoalSheet {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  employeeId     String
  employee       User            @relation("EmployeeGoalSheets", fields: [employeeId], references: [id], onDelete: Cascade)
  status         GoalSheetStatus @default(DRAFT)
  submittedAt    DateTime?
  approvedAt     DateTime?
  locked         Boolean         @default(false)
  currentCycleId String?
  currentCycle   Cycle?          @relation(fields: [currentCycleId], references: [id], onDelete: SetNull)
  goals          Goal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, employeeId, currentCycleId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@index([tenantId, currentCycleId])
  @@index([tenantId, createdAt])
}

model Goal {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  goalSheetId     String
  goalSheet       GoalSheet       @relation(fields: [goalSheetId], references: [id], onDelete: Cascade)
  title           String
  description     String
  thrustArea      String
  uomType         UOMType
  metricDirection MetricDirection
  targetValue     Float
  deadlineAt      DateTime?
  weightage       Float
  status          GoalStatus      @default(DRAFT)
  isShared        Boolean         @default(false)
  sharedGoalId    String?
  sharedGoal      SharedGoal?     @relation(fields: [sharedGoalId], references: [id], onDelete: SetNull)
  checkIns        CheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, goalSheetId])
  @@index([tenantId, sharedGoalId])
  @@index([tenantId, createdAt])
}

model SharedGoal {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ownerId     String
  owner       User             @relation("SharedGoalOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String
  targetValue Float
  deadlineAt  DateTime?
  thrustArea  String
  syncEnabled Boolean          @default(true)
  goals       Goal[]
  assignments GoalAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, ownerId])
  @@index([tenantId, createdAt])
}

model GoalAssignment {
  id             String     @id @default(cuid())
  employeeId     String
  employee       User       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sharedGoalId   String
  sharedGoal     SharedGoal @relation(fields: [sharedGoalId], references: [id], onDelete: Cascade)
  localWeightage Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, sharedGoalId])
  @@index([employeeId])
  @@index([sharedGoalId])
}

model CheckIn {
  id                 String         @id @default(cuid())
  tenantId           String
  tenant             Organization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  goalId             String
  goal               Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  quarter            Quarter
  plannedValue       Float
  actualValue        Float
  progressPercentage Float
  status             ProgressStatus
  submittedAt        DateTime?
  comments           CheckInComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, goalId, quarter])
  @@index([tenantId])
  @@index([tenantId, quarter])
  @@index([tenantId, status])
  @@index([tenantId, goalId])
  @@index([tenantId, createdAt])
}

model CheckInComment {
  id        String   @id @default(cuid())
  managerId String
  manager   User     @relation("ManagerCheckInComments", fields: [managerId], references: [id], onDelete: Cascade)
  checkInId String
  checkIn   CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  comment   String
  createdAt DateTime @default(now())

  @@index([managerId])
  @@index([checkInId])
}

model AuditLog {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actorId      String
  actor        User        @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Cascade)
  entityType   String
  entityId     String
  action       AuditAction
  previousData Json?
  newData      Json?
  timestamp    DateTime    @default(now())

  @@index([tenantId])
  @@index([tenantId, actorId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, action])
  @@index([tenantId, timestamp])
}

model Cycle {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  quarter    Quarter
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean     @default(false)
  goalSheets GoalSheet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, quarter])
  @@index([tenantId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, userId, read])
  @@index([tenantId, createdAt])
}

model Escalation {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Organization    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeId       String
  employee         User            @relation("EmployeeEscalations", fields: [employeeId], references: [id], onDelete: Cascade)
  
  managerId        String?
  manager          User?           @relation("ManagerEscalations", fields: [managerId], references: [id], onDelete: SetNull)

  type             EscalationType
  status           EscalationStatus @default(ACTIVE)
  level            EscalationLevel  @default(MANAGER)
  
  relatedEntityId  String?
  relatedEntityType String?
  
  reason           String

  resolvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, managerId])
  @@index([tenantId, status])
  @@index([tenantId, level])
  @@index([tenantId, createdAt])
}

// ------------------------------------------------------
// NextAuth Models
// ------------------------------------------------------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
